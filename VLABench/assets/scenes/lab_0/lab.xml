<mujoco model="lab">
  <compiler angle="radian" autolimits="true"/>

  <default>
    <default class="visual">
      <geom group="0" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="3" type="mesh"/>
    </default>
  </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1=".9 .9 .9" rgb2=".9 .9 .9" width="100" height="100"/>
        <texture file="textures/floor_gray.png" type="2d" name="texplane"/>
        
        <material name="floorplane" reflectance="0.0" shininess="0.0"
	        specular="0.0" texrepeat="3 3" texture="texplane" texuniform="true"/>
        <texture file="textures/plaster0.png" type="2d" name="tex-wall"/>
        <material name="walls_mat" reflectance="0.0" shininess="0.1" specular="0.8" texrepeat="3 3" texture="tex-wall" texuniform="true" />
        <material name="white" rgba="1 1 1 1"/>
        <material name="gray" rgba="0.753 0.753 0.753 1"/>
        <material name="black" rgba="0.149 0.149 0.149 1"/>
    </asset>

  <asset>
    <material name="balcony_base" specular="0.5" shininess="0.25" rgba="0.650005 0.650005 0.650005 1.000000"/>
    <material name="balcony_metal" specular="0.5" shininess="0.25" rgba="0.201901 0.201901 0.201901 1.000000"/>
    <material name="balcony_table" specular="0.5" shininess="0.25" rgba="0.071850 0.814041 0.482953 1.000000"/>
    <material name="mix_bege" specular="0.5" shininess="0.25" rgba="0.996120 1.000000 0.933511 1.000000"/>
    <material name="mix_button" specular="0.5" shininess="0.25" rgba="0.057802 0.057802 0.057802 1.000000"/>
    <material name="mix_glass" specular="0.5" shininess="0.25" rgba="0.002644 0.800000 0.689480 1.000000"/>
    <material name="potion_glass" specular="0.601695" shininess="0.25" rgba="0.029590 0.647717 0.800000 1.000000"/>
    <material name="potion_greenglow" specular="0.5" shininess="0.25" rgba="0.065005 0.800000 0.007147 1.000000"/>
    <material name="potion_valve" specular="0.5" shininess="0.25" rgba="0.239554 0.081257 0.010696 1.000000"/>
    <mesh file="lab/lab_0.obj" scale="0.3 0.3 0.3"/>
    <mesh file="lab/lab_1.obj" scale="0.3 0.3 0.3"/>
    <mesh file="lab/lab_2.obj" scale="0.3 0.3 0.3"/>
    <mesh file="lab/lab_3.obj" scale="0.3 0.3 0.3"/>
    <mesh file="lab/lab_4.obj" scale="0.3 0.3 0.3"/>
    <mesh file="lab/lab_5.obj" scale="0.3 0.3 0.3"/>
    <mesh file="lab/lab_6.obj" scale="0.3 0.3 0.3"/>
    <mesh file="lab/lab_7.obj" scale="0.3 0.3 0.3"/>
    <mesh file="lab/lab_8.obj" scale="0.3 0.3 0.3"/>
  </asset>
  <worldbody>

    <geom condim="3" group="1" material="floorplane" name="floor" pos="0 0 0" size="3 3 .125" type="plane"/>
    <geom pos="0 3 1.5" quat="0.7071 0.7071 0 0" size="3 1.5 0.01" type="box" conaffinity="0" contype="0" group="1" name="wall_left_visual" material="walls_mat"/>
    <geom pos="0 -3 1.5" quat="0.7071 -0.7071 0 0" size="3 1.5 0.01" type="box" conaffinity="0" contype="0" group="1" name="wall_right_visual" material="walls_mat"/>
    <geom pos="-3 0 1.5" quat="0.5 0.5 0.5 0.5" size="3 1.5 0.01" type="box" conaffinity="0" contype="0" group="1" name="wall_rear_visual" material="walls_mat"/>
    <geom pos="3 0 1.5" quat="0.5 0.5 -0.5 -0.5" size="3 1.5 0.01" type="box" conaffinity="0" contype="0" group="1" name="wall_front_visual" material="walls_mat"/>


    <body name="lab" pos="-0.2 0.1 -0.1">
      <geom type="mesh" mesh="lab_0" material="potion_greenglow" class="visual"/>
      <geom type="mesh" mesh="lab_1" material="potion_glass" class="visual"/>
      <geom type="mesh" mesh="lab_2" material="mix_button" class="visual"/>
      <geom type="mesh" mesh="lab_3" material="potion_valve" class="visual"/>
      <geom type="mesh" mesh="lab_4" material="mix_glass" class="visual"/>
      <geom type="mesh" mesh="lab_5" material="balcony_table" class="visual"/>
      <geom type="mesh" mesh="lab_6" material="mix_bege" class="visual"/>
      <geom type="mesh" mesh="lab_7" material="balcony_metal" class="visual"/>
      <geom type="mesh" mesh="lab_8" material="balcony_base" class="visual"/>
      <!-- <geom type="mesh" mesh="lab_0" class="collision"/>
      <geom type="mesh" mesh="lab_1" class="collision"/>
      <geom type="mesh" mesh="lab_2" class="collision"/>
      <geom type="mesh" mesh="lab_3" class="collision"/>
      <geom type="mesh" mesh="lab_4" class="collision"/> -->
      <!-- <geom type="mesh" mesh="lab_5" class="collision"/> -->
      <!-- <geom type="mesh" mesh="lab_6" class="collision"/>
      <geom type="mesh" mesh="lab_7" class="collision"/> -->
      <!-- <geom type="mesh" mesh="lab_8" class="collision"/> -->
    </body>

  </worldbody>
</mujoco>